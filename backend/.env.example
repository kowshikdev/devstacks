# Copy to backend/.env for local development. Do not place production secrets in this file.
DEVSTACKS_ENV=development

# Comma-separated browser origins allowed to call this API (CORS). Defaults to
# localhost:3000 for local frontend dev; add the deployed frontend URL in production.
DEVSTACKS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# This URL is public. Retrieve keys from the Supabase dashboard's API settings.
SUPABASE_URL=https://zscwpqtqdqoqpgjhckif.supabase.co

# Low-privilege key for server-side public API calls when required.
SUPABASE_PUBLISHABLE_KEY=

# Server-only secret that bypasses RLS. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# FastAPI will validate bearer tokens against this issuer in FOUND-002.
SUPABASE_JWT_ISSUER=https://zscwpqtqdqoqpgjhckif.supabase.co/auth/v1

# Server-only URL-safe base64 32-byte Fernet key used to encrypt connector tokens.
DEVSTACKS_ENCRYPTION_KEY=

# Register a GitHub OAuth App with this exact callback URL. Keep the secret server-only.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/v1/connectors/github/callback

# Server-only high-entropy secret configured on every repository webhook.
GITHUB_WEBHOOK_SECRET=

# Direct Postgres connection string (not the PostgREST/httpx path above) used
# only by devstacks-claims-worker's LangGraph checkpointer for durable HITL
# replay. Server-only.
SUPABASE_DB_URL=

# Claim-extraction/verifier agent model, reached through an OpenAI-compatible
# endpoint (e.g. OpenRouter). Server-only; the agent extra must be installed.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=